# Anjuman web app — environment variables

# Prisma + database
# For local dev, SQLite is used (file:./dev.db). For production, swap to Postgres.
DATABASE_URL="file:./dev.db"

# NextAuth
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="dev-secret-change-me-in-production-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# OTP delivery (for production)
# Twilio for SMS OTP, Resend for email magic link
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_PHONE_NUMBER="+1234567890"
# RESEND_API_KEY=""

# Supabase (when you switch from SQLite to Postgres)
# NEXT_PUBLIC_SUPABASE_URL=""
# NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# SUPABASE_SERVICE_ROLE_KEY=""

# Social account OAuth (Meta covers Instagram + Facebook in one flow)
# When ANY of these are missing, the start routes short-circuit to a
# dev-mock callback that creates a fake `dev_mock` SocialAccount, so the
# full UI flow remains testable without provider credentials.
# META_APP_ID=""
# META_APP_SECRET=""
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# TIKTOK_CLIENT_KEY=""
# TIKTOK_CLIENT_SECRET=""

# Stripe (for international card payments, optional in v1)
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""

# Sentry (for error tracking, recommended in production)
# SENTRY_DSN=""
# NEXT_PUBLIC_SENTRY_DSN=""
# Email sign-in: use a verified sender from your Resend account.
RESEND_API_KEY=""
EMAIL_FROM=""
# Only honored by development servers. Never exposes codes in production.
EMAIL_PREVIEW_MODE="false"
# Set AUTH_URL and NEXTAUTH_URL to the actual application origin if overriding port 3000.
